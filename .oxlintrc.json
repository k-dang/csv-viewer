{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist-electron", "dist-renderer", "release", "src/renderer/components/ui"],
  "rules": {
    // Every hit in this codebase is a deliberate snapshot taken before the loop body deletes from
    // the collection it is iterating (worker disposal, comparison close, artifact retirement).
    // Dropping the spread would skip entries, so the rule is wrong here rather than the code.
    "unicorn/no-useless-spread": "off"
  },
  "overrides": [
    // The shared workspace runs in the Electron main process today and in a browser page once the
    // web runtime lands, so it stays free of Electron, Node, and runtime-specific trees. The native
    // DuckDB driver stays in the duckdb modules the web adapter will sit beside.
    {
      "files": ["src/workspace/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["electron", "@duckdb/node-api", "fs", "path", "os", "child_process", "worker_threads"],
            "patterns": ["node:*", "**/main/**", "**/preload/**", "**/renderer/**"]
          }
        ]
      }
    },
    // The two named database modules are where the native driver is allowed to live.
    {
      "files": [
        "src/workspace/duckdb/duckdb-database.ts",
        "src/workspace/duckdb/duckdb-comparison-executor.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["electron", "fs", "path", "os", "child_process", "worker_threads"],
            "patterns": ["node:*", "**/main/**", "**/preload/**", "**/renderer/**"]
          }
        ]
      }
    },
    // The renderer reaches its host only through the injected CsvViewerRuntime: no Electron, no
    // Node, no transport names, and no reaching into the workspace or main trees.
    {
      "files": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["electron", "fs", "path", "os", "child_process", "worker_threads"],
            "patterns": ["node:*", "**/ipc-channels", "**/workspace/**", "**/main/**", "**/preload/**"]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "csvViewer",
            "message": "Take the runtime from useCsvViewerRuntime() instead of the Electron preload global."
          }
        ]
      }
    },
    // The composition root's adapter is the one module allowed to read the preload bridge.
    {
      "files": ["src/renderer/electron-runtime.ts"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    // Tests and test fixtures build real CSV Sources on disk and drive the native driver directly.
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/main/testing/**"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off"
      }
    }
  ]
}
