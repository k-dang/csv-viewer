{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist-electron",
    "dist-renderer",
    "dist-web",
    "release",
    "packages/ui/src/components/ui",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "complexity": "warn",
    // Every hit in this codebase is a deliberate snapshot taken before the loop body deletes from
    // the collection it is iterating (worker disposal, comparison close, artifact retirement).
    // Dropping the spread would skip entries, so the rule is wrong here rather than the code.
    "unicorn/no-useless-spread": "off"
  },
  "overrides": [
    // The workspace package runs in Electron main and in the browser page. Runtime adapters stay
    // in their application package.
    {
      "files": ["packages/workspace/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(node:)?(fs|path|os|child_process|worker_threads)(/|$)|^(electron|@duckdb/|@csv-viewer/(desktop|web|ui))",
                "message": "The workspace package must run unchanged in both applications: no runtime imports."
              }
            ]
          }
        ]
      }
    },
    // Shared UI reaches its runtime only through CsvViewer. The comparison presentation helper is
    // also part of the product interface; every other workspace implementation module stays hidden.
    {
      "files": ["packages/ui/src/**/*.ts", "packages/ui/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(node:)?(fs|path|os|child_process|worker_threads)(/|$)|^electron(/|$)|^@csv-viewer/(desktop|web)(/|$)|^@csv-viewer/workspace/(?!csv-viewer$|comparison-presentation$)",
                "message": "Shared UI reaches runtime behavior through CsvViewer, never through an application or workspace implementation module."
              }
            ]
          }
        ]
      }
    },
    // Tests build real CSV Sources on disk and drive the native driver directly.
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test-helpers/**/*.ts", "**/test-helpers/**/*.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
