{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // src/renderer is out of scope here, so vite/client supplies the `?url` asset declarations
    // that src/renderer/vite-env.d.ts provides for the app build.
    "types": ["vite/client"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/renderer",
    "src/shared",
    "src/test-helpers",
    "src/web",
    "src/workspace"
  ],
  "exclude": []
}
