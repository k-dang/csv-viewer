{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/ui/src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "e2e", "playwright.config.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["**/dist-electron", "**/dist-renderer", "**/dist-web"]
}
