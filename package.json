{
  "name": "csv-viewer",
  "version": "1.1.0",
  "description": "A desktop CSV viewer built with Electron, React, TypeScript, AG Grid, and DuckDB.",
  "productName": "CSV Viewer",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "clean": "node scripts/clean-build.cjs",
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs .\"",
    "build": "pnpm run clean && pnpm run typecheck && node scripts/check-workspace-isolation.mjs && vite build && tsc -p tsconfig.electron.json",
    "package": "pnpm run build && electron-builder --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "pnpm run build && node scripts/launch-electron.cjs ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.2",
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@base-ui/react": "^1.4.1",
    "@duckdb/node-api": "1.5.2-r.1",
    "@floating-ui/react-dom": "^2.1.8",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-test-renderer": "19.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1",
    "react-test-renderer": "19.1.1",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.kdang.csvviewer",
    "productName": "CSV Viewer",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "icon": "icon",
    "asar": true,
    "npmRebuild": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "CSV.Viewer-${version}-Setup-${arch}.${ext}",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CSV.Viewer-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
