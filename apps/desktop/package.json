{
  "name": "@csv-viewer/desktop",
  "version": "1.1.0",
  "description": "CSV Viewer desktop application",
  "productName": "CSV Viewer",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "pnpm --filter @csv-viewer/workspace build && tsc -p tsconfig.electron.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs .\"",
    "build": "pnpm --filter @csv-viewer/workspace build && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "pnpm --dir ../.. run build && electron-builder --publish never",
    "start": "pnpm run build && node scripts/launch-electron.cjs ."
  },
  "dependencies": {
    "@csv-viewer/workspace": "workspace:*",
    "@duckdb/node-api": "1.5.5-r.4"
  },
  "devDependencies": {
    "@csv-viewer/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.kdang.csvviewer",
    "productName": "CSV Viewer",
    "directories": {
      "buildResources": "../../assets",
      "output": "../../release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "icon": "icon",
    "asar": true,
    "npmRebuild": true,
    "win": {
      "icon": "icon.ico",
      "target": ["nsis", "portable"],
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "CSV.Viewer-${version}-Setup-${arch}.${ext}",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CSV.Viewer-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "icon.icns",
      "target": "dmg",
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icon.png",
      "target": "AppImage",
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
