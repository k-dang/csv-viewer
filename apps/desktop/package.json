{
  "name": "@csv-viewer/desktop",
  "version": "1.1.0",
  "description": "CSV Viewer desktop application",
  "productName": "CSV Viewer",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @csv-viewer/workspace build && pnpm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs .\"",
    "build": "pnpm --filter @csv-viewer/workspace build && vite build && pnpm run build:electron",
    "build:electron": "vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "pnpm --dir ../.. run build && electron-builder --publish never",
    "start": "pnpm run build && node scripts/launch-electron.cjs ."
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4"
  },
  "devDependencies": {
    "@csv-viewer/ui": "workspace:*",
    "@csv-viewer/workspace": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.kdang.csvviewer",
    "productName": "CSV Viewer",
    "directories": {
      "buildResources": "../../assets",
      "output": "../../release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "icon": "icon",
    "asar": true,
    "npmRebuild": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "CSV.Viewer-${version}-Setup-${arch}.${ext}",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CSV.Viewer-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "icon.icns",
      "target": "dmg",
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icon.png",
      "target": "AppImage",
      "artifactName": "CSV.Viewer-${version}-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
